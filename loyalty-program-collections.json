{
  "collections": [
    {
      "name": "users",
      "description": "User accounts for customers, store owners, and admins",
      "fields": [
        {
          "name": "_id",
          "type": "ObjectId",
          "description": "Unique identifier for the user",
          "required": true,
          "auto": true
        },
        {
          "name": "phoneNumber",
          "type": "String",
          "description": "Iranian phone number (09XXXXXXXXX format)",
          "required": true,
          "unique": true,
          "indexed": true,
          "pattern": "^09[0-9]{9}$",
          "maxLength": 11
        },
        {
          "name": "firstName",
          "type": "String",
          "description": "User's first name",
          "required": false,
          "maxLength": 100,
          "trim": true
        },
        {
          "name": "lastName",
          "type": "String",
          "description": "User's last name",
          "required": false,
          "maxLength": 100,
          "trim": true
        },
        {
          "name": "role",
          "type": "String",
          "description": "User role in the system",
          "required": true,
          "default": "customer",
          "enum": ["customer", "store", "admin"]
        },
        {
          "name": "status",
          "type": "String",
          "description": "Current status of the user account",
          "required": true,
          "default": "active",
          "enum": ["active", "blocked", "deleted"],
          "indexed": true
        },
        {
          "name": "lastActivity",
          "type": "Date",
          "description": "Last activity timestamp",
          "required": true,
          "default": "Date.now"
        },
        {
          "name": "createdAt",
          "type": "Date",
          "description": "Account creation timestamp",
          "required": true,
          "auto": true
        },
        {
          "name": "updatedAt",
          "type": "Date",
          "description": "Last update timestamp",
          "required": true,
          "auto": true
        }
      ]
    },
    {
      "name": "stores",
      "description": "Store information and loyalty settings",
      "fields": [
        {
          "name": "_id",
          "type": "ObjectId",
          "description": "Unique identifier for the store",
          "required": true,
          "auto": true
        },
        {
          "name": "name",
          "type": "String",
          "description": "Store name",
          "required": true,
          "maxLength": 100,
          "trim": true
        },
        {
          "name": "ownerName",
          "type": "String",
          "description": "Store owner's name",
          "required": true,
          "maxLength": 100,
          "trim": true
        },
        {
          "name": "phoneNumber",
          "type": "String",
          "description": "Store contact phone number",
          "required": true,
          "unique": true,
          "indexed": true,
          "pattern": "^09[0-9]{9}$",
          "maxLength": 11
        },
        {
          "name": "userId",
          "type": "ObjectId",
          "description": "Reference to the store owner's user account",
          "required": true,
          "indexed": true,
          "ref": "users"
        },
        {
          "name": "address",
          "type": "Object",
          "description": "Store address information",
          "required": true,
          "fields": [
            {
              "name": "city",
              "type": "String",
              "description": "City where store is located",
              "required": true,
              "trim": true
            },
            {
              "name": "street",
              "type": "String",
              "description": "Street address",
              "required": false,
              "trim": true
            },
            {
              "name": "coordinates",
              "type": "Object",
              "description": "Geographic coordinates",
              "required": false,
              "fields": [
                {
                  "name": "lat",
                  "type": "Number",
                  "description": "Latitude",
                  "required": false
                },
                {
                  "name": "lng",
                  "type": "Number",
                  "description": "Longitude",
                  "required": false
                }
              ]
            }
          ]
        },
        {
          "name": "loyaltySettings",
          "type": "Object",
          "description": "Store's loyalty program configuration",
          "required": true,
          "fields": [
            {
              "name": "tiers",
              "type": "Array",
              "description": "Loyalty tiers configuration",
              "required": false,
              "default": [],
              "items": {
                "type": "Object",
                "fields": [
                  {
                    "name": "minAmount",
                    "type": "Number",
                    "description": "Minimum purchase amount for this tier",
                    "required": true,
                    "minimum": 0
                  },
                  {
                    "name": "rewardType",
                    "type": "String",
                    "description": "Type of reward for this tier",
                    "required": true,
                    "enum": ["discount", "cashback", "lottery"]
                  },
                  {
                    "name": "value",
                    "type": "Number",
                    "description": "Reward value",
                    "required": true,
                    "minimum": 0
                  },
                  {
                    "name": "description",
                    "type": "String",
                    "description": "Tier description",
                    "required": false
                  }
                ]
              }
            },
            {
              "name": "lotteryFrequency",
              "type": "String",
              "description": "Frequency of lottery draws",
              "required": false,
              "default": "none",
              "enum": ["weekly", "monthly", "none"]
            },
            {
              "name": "defaultCashbackRate",
              "type": "Number",
              "description": "Default cashback percentage",
              "required": false,
              "default": 0,
              "minimum": 0
            }
          ]
        },
        {
          "name": "plan",
          "type": "Object",
          "description": "Store subscription plan",
          "required": true,
          "fields": [
            {
              "name": "type",
              "type": "String",
              "description": "Plan type",
              "required": false,
              "default": "free",
              "enum": ["free", "premium"]
            },
            {
              "name": "startDate",
              "type": "Date",
              "description": "Plan start date",
              "required": true,
              "default": "Date.now"
            },
            {
              "name": "endDate",
              "type": "Date",
              "description": "Plan end date",
              "required": true
            }
          ]
        },
        {
          "name": "role",
          "type": "String",
          "description": "Role identifier",
          "required": true,
          "default": "store",
          "enum": ["store"]
        },
        {
          "name": "createdAt",
          "type": "Date",
          "description": "Store creation timestamp",
          "required": true,
          "auto": true
        },
        {
          "name": "updatedAt",
          "type": "Date",
          "description": "Last update timestamp",
          "required": true,
          "auto": true
        }
      ]
    },
    {
      "name": "admins",
      "description": "Administrator accounts",
      "fields": [
        {
          "name": "_id",
          "type": "ObjectId",
          "description": "Unique identifier for the admin",
          "required": true,
          "auto": true
        },
        {
          "name": "phoneNumber",
          "type": "String",
          "description": "Admin phone number",
          "required": true,
          "unique": true,
          "indexed": true,
          "pattern": "^09[0-9]{9}$",
          "maxLength": 11
        },
        {
          "name": "name",
          "type": "String",
          "description": "Admin name",
          "required": false,
          "maxLength": 100,
          "trim": true
        },
        {
          "name": "role",
          "type": "String",
          "description": "Role identifier",
          "required": true,
          "default": "admin",
          "enum": ["admin"]
        },
        {
          "name": "permissions",
          "type": "Array",
          "description": "Admin permissions",
          "required": true,
          "items": {
            "type": "String",
            "enum": [
              "manage_stores",
              "view_reports",
              "run_lottery",
              "manage_users"
            ]
          }
        },
        {
          "name": "createdAt",
          "type": "Date",
          "description": "Admin creation timestamp",
          "required": true,
          "auto": true
        },
        {
          "name": "updatedAt",
          "type": "Date",
          "description": "Last update timestamp",
          "required": true,
          "auto": true
        }
      ]
    },
    {
      "name": "transactions",
      "description": "Transaction records for purchases, cashbacks, and lottery wins",
      "fields": [
        {
          "name": "_id",
          "type": "ObjectId",
          "description": "Unique identifier for the transaction",
          "required": true,
          "auto": true
        },
        {
          "name": "userId",
          "type": "ObjectId",
          "description": "Reference to the user",
          "required": true,
          "indexed": true,
          "ref": "users"
        },
        {
          "name": "storeId",
          "type": "ObjectId",
          "description": "Reference to the store",
          "required": true,
          "indexed": true,
          "ref": "stores"
        },
        {
          "name": "type",
          "type": "String",
          "description": "Transaction type",
          "required": true,
          "enum": ["purchase", "cashback", "lottery"]
        },
        {
          "name": "amount",
          "type": "Number",
          "description": "Transaction amount",
          "required": true,
          "minimum": 0
        },
        {
          "name": "scratchCode",
          "type": "String",
          "description": "Scratch card code if applicable",
          "required": false
        },
        {
          "name": "entryMethod",
          "type": "String",
          "description": "Method used to enter the transaction",
          "required": true,
          "enum": ["sms", "qr"]
        },
        {
          "name": "description",
          "type": "String",
          "description": "Transaction description",
          "required": false
        },
        {
          "name": "createdAt",
          "type": "Date",
          "description": "Transaction creation timestamp",
          "required": true,
          "auto": true
        },
        {
          "name": "updatedAt",
          "type": "Date",
          "description": "Last update timestamp",
          "required": true,
          "auto": true
        }
      ]
    },
    {
      "name": "scratchcards",
      "description": "Scratch card codes and their rewards",
      "fields": [
        {
          "name": "_id",
          "type": "ObjectId",
          "description": "Unique identifier for the scratch card",
          "required": true,
          "auto": true
        },
        {
          "name": "code",
          "type": "String",
          "description": "Unique 12-character scratch card code",
          "required": true,
          "unique": true,
          "indexed": true,
          "pattern": "^[A-Z0-9]{12}$",
          "maxLength": 12
        },
        {
          "name": "storeId",
          "type": "ObjectId",
          "description": "Reference to the store that issued the card",
          "required": true,
          "indexed": true,
          "ref": "stores"
        },
        {
          "name": "status",
          "type": "String",
          "description": "Current status of the scratch card",
          "required": true,
          "default": "unused",
          "enum": ["unused", "used", "expired"]
        },
        {
          "name": "userId",
          "type": "ObjectId",
          "description": "Reference to the user who used the card",
          "required": false,
          "ref": "users"
        },
        {
          "name": "reward",
          "type": "Object",
          "description": "Reward configuration for this card",
          "required": true,
          "fields": [
            {
              "name": "type",
              "type": "String",
              "description": "Type of reward",
              "required": true,
              "enum": ["discount", "cashback", "lottery"]
            },
            {
              "name": "value",
              "type": "Number",
              "description": "Reward value",
              "required": true,
              "minimum": 0
            }
          ]
        },
        {
          "name": "entryMethod",
          "type": "String",
          "description": "Method used to redeem the card",
          "required": false,
          "enum": ["sms", "qr"]
        },
        {
          "name": "qrUrl",
          "type": "String",
          "description": "QR code URL for the scratch card",
          "required": true
        },
        {
          "name": "usedAt",
          "type": "Date",
          "description": "Timestamp when the card was used",
          "required": false
        },
        {
          "name": "expiresAt",
          "type": "Date",
          "description": "Expiration date of the scratch card",
          "required": true
        },
        {
          "name": "createdAt",
          "type": "Date",
          "description": "Card creation timestamp",
          "required": true,
          "auto": true
        },
        {
          "name": "updatedAt",
          "type": "Date",
          "description": "Last update timestamp",
          "required": true,
          "auto": true
        }
      ]
    },
    {
      "name": "otps",
      "description": "One-time password codes for authentication",
      "fields": [
        {
          "name": "_id",
          "type": "ObjectId",
          "description": "Unique identifier for the OTP",
          "required": true,
          "auto": true
        },
        {
          "name": "phoneNumber",
          "type": "String",
          "description": "Phone number the OTP was sent to",
          "required": true,
          "indexed": true,
          "pattern": "^09[0-9]{9}$",
          "maxLength": 11
        },
        {
          "name": "userId",
          "type": "ObjectId",
          "description": "Reference to the user if available",
          "required": false,
          "ref": "users"
        },
        {
          "name": "code",
          "type": "String",
          "description": "6-digit OTP code",
          "required": true,
          "pattern": "^[0-9]{6}$",
          "maxLength": 6
        },
        {
          "name": "context",
          "type": "String",
          "description": "Context in which the OTP was generated",
          "required": true,
          "enum": ["login", "scratch"]
        },
        {
          "name": "scratchCode",
          "type": "String",
          "description": "Scratch card code if OTP is for scratch card verification",
          "required": false
        },
        {
          "name": "status",
          "type": "String",
          "description": "Current status of the OTP",
          "required": true,
          "default": "sent",
          "enum": ["sent", "verified", "expired"]
        },
        {
          "name": "expiresAt",
          "type": "Date",
          "description": "Expiration timestamp for the OTP",
          "required": true
        },
        {
          "name": "createdAt",
          "type": "Date",
          "description": "OTP creation timestamp",
          "required": true,
          "auto": true,
          "ttl": 300
        },
        {
          "name": "updatedAt",
          "type": "Date",
          "description": "Last update timestamp",
          "required": true,
          "auto": true
        }
      ]
    }
  ],
  "relationships": [
    {
      "from": "users",
      "to": "stores",
      "type": "one-to-many",
      "description": "A user can own multiple stores"
    },
    {
      "from": "users",
      "to": "transactions",
      "type": "one-to-many",
      "description": "A user can have multiple transactions"
    },
    {
      "from": "users",
      "to": "scratchcards",
      "type": "one-to-many",
      "description": "A user can use multiple scratch cards"
    },
    {
      "from": "users",
      "to": "otps",
      "type": "one-to-many",
      "description": "A user can have multiple OTPs"
    },
    {
      "from": "stores",
      "to": "transactions",
      "type": "one-to-many",
      "description": "A store can have multiple transactions"
    },
    {
      "from": "stores",
      "to": "scratchcards",
      "type": "one-to-many",
      "description": "A store can issue multiple scratch cards"
    }
  ],
  "indexes": [
    {
      "collection": "users",
      "fields": ["phoneNumber"],
      "type": "unique"
    },
    {
      "collection": "users",
      "fields": ["status"],
      "type": "index"
    },
    {
      "collection": "stores",
      "fields": ["phoneNumber"],
      "type": "unique"
    },
    {
      "collection": "stores",
      "fields": ["userId"],
      "type": "index"
    },
    {
      "collection": "admins",
      "fields": ["phoneNumber"],
      "type": "unique"
    },
    {
      "collection": "transactions",
      "fields": ["userId"],
      "type": "index"
    },
    {
      "collection": "transactions",
      "fields": ["storeId"],
      "type": "index"
    },
    {
      "collection": "scratchcards",
      "fields": ["code"],
      "type": "unique"
    },
    {
      "collection": "scratchcards",
      "fields": ["storeId"],
      "type": "index"
    },
    {
      "collection": "otps",
      "fields": ["phoneNumber"],
      "type": "index"
    },
    {
      "collection": "otps",
      "fields": ["createdAt"],
      "type": "ttl",
      "expireAfterSeconds": 300
    }
  ],
  "metadata": {
    "project": "Loyalty Program",
    "description": "MongoDB collections for a loyalty program system with scratch cards, stores, users, and transactions",
    "version": "1.0.0",
    "createdAt": "2024-12-19",
    "database": "loyalty_program"
  }
}
